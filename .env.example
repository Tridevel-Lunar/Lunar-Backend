# LUNAR Backend — copy to .env (overrides compose-provided vars)
# cp .env.example .env
#
# All vars have defaults in app/core/config.py and compose.dev.yaml.
# Only set what you need to override for local development.

# --- PostgreSQL ---
# DATABASE_URL=postgresql+psycopg://lunar:lunar@localhost:5432/lunar

# --- Auth ---
# SECRET_KEY=dev-secret-change-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- LAIKA / RAG ---
# LAIKA_LLM_PROVIDER=gemini          # gemini | ollama | deepseek
# LAIKA_EMBEDDING_PROVIDER=gemini    # gemini | ollama
# LAIKA_TOP_K=5
# LAIKA_TIMEOUT_SECONDS=60
# LAIKA_CONTEXT_WINDOW=0
# LAIKA_MAX_HISTORY_TOKENS=8000
# LAIKA_RESERVED_OUTPUT_TOKENS=1500

# --- Gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- DeepSeek (OpenAI-compatible API) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- Ollama ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_NUM_CTX=0
# OLLAMA_KEEP_ALIVE=5m

# --- Tavily ---
# TAVILY_API_KEY=

# --- Admin bootstrap ---
# ADMIN_EMAILS=

# --- Arena RQ worker (compose sets redis://redis:6379/0) ---
# REDIS_URL=redis://redis:6379/0
# ARENA_RUN_SYNC=false
# ARENA_RQ_QUEUE_NAME=arena-runs
# ARENA_RUN_JOB_TIMEOUT=30
